<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug precisa de HTTP para o emulador e para um IP de LAN, e o Android
  não expressa "só rede privada" neste XML. Quem recusa host público é
  BaseUrlPolicy, antes de a chave ou o vital saírem do aparelho.
  Release continua sem HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
