# Vertex AI custom container — TCN multi-horizon serving
FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AIP_HTTP_PORT=8080 \
    AIP_HEALTH_ROUTE=/health \
    AIP_PREDICT_ROUTE=/predict

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# torch CPU wheel (smaller than full CUDA)
RUN pip install --upgrade pip \
    && pip install \
        torch==2.2.2 \
        --index-url https://download.pytorch.org/whl/cpu \
    && pip install \
        flask==3.0.3 \
        numpy==1.26.4 \
        scikit-learn==1.4.2 \
        gunicorn==22.0.0 \
        google-cloud-storage==2.18.2

COPY tcn_server.py /app/tcn_server.py

EXPOSE 8080

CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "4", "--timeout", "120", "tcn_server:app"]
