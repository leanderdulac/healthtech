# Ambiente: development | production | staging
ENVIRONMENT=development

# secure = API enxuta | full = monólito (dashboard + WS; só com repo completo)
APP_MODE=secure

# Segurança — gere com: openssl rand -hex 32
SECRET_SALT=altere-este-salt-em-producao

# Chaves de API (comparação exata via hmac — sem prefix matching)
# Admin / full: wearables:write + wearables:read + admin
API_KEY=
ADMIN_API_KEY=

# Escopos dedicados
INGEST_API_KEY=
READ_API_KEY=

# true apenas em dev local — ignorado em production
AUTH_DISABLED=false

# Origens CORS (vírgula). Em produção defina explicitamente (nunca *).
CORS_ORIGINS=http://localhost:8000,http://localhost:8080,http://127.0.0.1:8080

# Whitelist anti-IDOR (opcional). Vazio = qualquer patient_id com escopo adequado.
# Admin sempre tem acesso universal.
ALLOWED_PATIENT_IDS=

# Rate limits (slowapi)
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_INGEST=60/minute
RATE_LIMIT_BATCH=30/minute
RATE_LIMIT_ADMIN=10/minute

# Telemetria em memória
HISTORY_MAX_PER_PATIENT=100
