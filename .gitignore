# Formatos voláteis (exceto scraping USP)
*.csv
*.parquet
!data/scraping/**
*.jsonl
!data/scraping/**

# Pesos treinados localmente — versionar só JSON de metadados
*.pkl
*.pt
*.joblib
data/models/*.pkl
data/models/*.pt
data/vertex_deploy/**/*.pkl
data/vertex_deploy/**/*.pt
data/vertex_deploy/**/*.joblib

