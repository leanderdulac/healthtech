companion-android/local.properties
companion-android/.gradle/
companion-android/**/build/
companion-android/**/*.apk
companion-android/**/*.aab
companion-android/**/*.dex
companion-android/.idea/

# Bytecode do vendor gerado
saude_responsiva_secure/_vendor_src/**/__pycache__/

